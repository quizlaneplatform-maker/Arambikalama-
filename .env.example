# Copy this file to .env and fill in your values.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# PORT=3000

# ---- Email for login codes (OTP), option 1: Brevo over HTTPS. Use this when hosting on Render's
# free plan, which blocks the SMTP ports Gmail needs. Free: 300 emails/day, no domain needed.
# Sign up at https://www.brevo.com, verify your sender email under Senders, then create a key at
# https://app.brevo.com/settings/keys/api. MAIL_FROM must be that verified sender.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Aarambikallama <yourname@gmail.com>

# ---- Option 2: SMTP. Gmail example: turn on 2-Step Verification,
# create an App Password at https://myaccount.google.com/apppasswords and paste it below.
# Leave these unset during development and the code is printed in the server console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your16charapppassword
# MAIL_FROM=Aarambikallama <yourname@gmail.com>

# ---- Where data is stored. Leave unset to use JSON files in ./data (or DATA_DIR).
# Set it to a Postgres connection string (e.g. a free Neon database) to keep accounts,
# quizzes and reports on hosts without a persistent disk, like Render's free plan.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Production (set these on your hosting platform, not in a committed file)
# NODE_ENV=production        # turns on: Secure cookies behind HTTPS, HSTS, and requires SMTP_*
# DATA_DIR=/data             # folder on a persistent disk/volume (users, quizzes, reports, sessions)
# TRUST_PROXY=1              # defaults to 1 in production; number of proxies in front of the app
# ALLOW_CONSOLE_OTP=true     # private demos only: start in production without email (codes go to logs)

# ---- Question images: Neon Object Storage (private bucket "assets", declared in neon.ts).
# `neon deploy` / `neon env pull` write these. Without them the editor hides "Add picture".
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
