# Copy this file to .env and fill in your values.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# PORT=3000

# ---- Email for login codes (OTP). Gmail example: turn on 2-Step Verification,
# create an App Password at https://myaccount.google.com/apppasswords and paste it below.
# Leave these unset during development and the code is printed in the server console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your16charapppassword
# MAIL_FROM=Aarambikallama <yourname@gmail.com>

# ---- Production (set these on your hosting platform, not in a committed file)
# NODE_ENV=production        # turns on: Secure cookies behind HTTPS, HSTS, and requires SMTP_*
# DATA_DIR=/data             # folder on a persistent disk/volume (users, quizzes, reports, sessions)
# TRUST_PROXY=1              # defaults to 1 in production; number of proxies in front of the app
# ALLOW_CONSOLE_OTP=true     # private demos only: start in production without email (codes go to logs)
